{
  "consumers": [
    {
      "repo": "streamos",
      "worktree": "main",
      "plugin": "anti-slop",
      "dest": "tools/oxlint/anti-slop"
    },
    {
      "repo": "streamos",
      "worktree": "main",
      "plugin": "effect-idioms",
      "dest": "tools/oxlint/effect-idioms"
    },
    {
      "repo": "streamos",
      "worktree": "main",
      "plugin": "ts-idioms",
      "dest": "tools/oxlint/ts-idioms"
    },
    {
      "repo": "tooee",
      "worktree": "main",
      "plugin": "anti-slop",
      "dest": "tools/oxlint/anti-slop"
    },
    {
      "repo": "tooee",
      "worktree": "main",
      "plugin": "react-idioms",
      "dest": "tools/oxlint/react-idioms"
    },
    {
      "repo": "effect-ink",
      "worktree": "main",
      "plugin": "anti-slop",
      "dest": "tools/oxlint/anti-slop"
    },
    {
      "repo": "streamsy",
      "worktree": "effect",
      "plugin": "anti-slop",
      "dest": "tools/oxlint/anti-slop",
      "notes": "Streamsy main has no Oxlint plugins. The effect line carries them."
    },
    {
      "repo": "streamsy",
      "worktree": "effect",
      "plugin": "effect-idioms",
      "dest": "tools/oxlint/effect-idioms"
    },
    {
      "repo": "streamsy-extras",
      "worktree": "main",
      "plugin": "anti-slop",
      "dest": "tools/oxlint/anti-slop"
    },
    {
      "repo": "streamsy-extras",
      "worktree": "main",
      "plugin": "effect-idioms",
      "dest": "tools/oxlint/effect-idioms"
    }
  ]
}
